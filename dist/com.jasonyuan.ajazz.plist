<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jasonyuan.ajazz</string>

    <!-- Absolute path to the installed binary. The installer rewrites this. -->
    <key>ProgramArguments</key>
    <array>
        <string>__BIN__</string>
    </array>

    <!-- Run periodically (seconds). When the keyboard is disconnected the -->
    <!-- program just finds no device and exits cheaply, so this also acts as -->
    <!-- the "sync shortly after connect" mechanism. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Run once at load/login too, so it syncs right away. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG__/ajazz.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG__/ajazz.err.log</string>
</dict>
</plist>
